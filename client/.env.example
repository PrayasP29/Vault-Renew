# Backend origin, without a trailing slash or /api suffix (the API client appends /api).
# Required - the app throws a config error at startup if it is missing.
# Local dev:  http://localhost:5000
# Production: set this to the current Cloudflare Tunnel or stable backend origin.
VITE_API_BASE_URL=http://localhost:5000

# Legacy local variable supported temporarily by src/services/api.js.
# Prefer VITE_API_BASE_URL for all new environments.
# VITE_API_URL=

VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_MEASUREMENT_ID=
VITE_FIREBASE_VAPID_KEY=
