NODE_ENV=development
PORT=5000
MONGO_URI=mongodb://127.0.0.1:27017/vault-renew

# Use long random values in every non-development environment.
JWT_SECRET=your_access_token_secret
JWT_REFRESH_SECRET=your_refresh_token_secret

# Frontend URL used in verification email links.
CLIENT_URL=http://localhost:5173
# Comma-separated browser origins allowed by CORS. Keep localhost entries for local development.
FRONTEND_URLS=http://localhost:5173,http://127.0.0.1:5173

# Optional email delivery. Leave blank for local mock/no-send behavior.
RESEND_API_KEY=
EMAIL_FROM=Vault-Renew <onboarding@resend.dev>

# AI/OCR provider
AI_PROVIDER=mock
AI_API_KEY=
AI_BASE_URL=https://api.openai.com/v1
AI_MODEL=gpt-4o-mini
AI_TIMEOUT_MS=30000
AI_MOCK_BEHAVIOR=success

# Firebase Admin SDK
FIREBASE_PROJECT_ID=vault-renew
GOOGLE_APPLICATION_CREDENTIALS=C:\path\to\firebase-service-account.json

# Optional application settings
DEFAULT_TIMEZONE=Asia/Kolkata
MAX_UPLOAD_STORAGE_BYTES=104857600
ENABLE_DEV_TEST_AUTH=false
TEST_FCM_MOCK=false
