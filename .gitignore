# Dependencies
node_modules/
client/node_modules/
server/node_modules/

# Build output
dist/
build/
client/dist/
client/.vite/
server/dist/

# Environment - secrets (keep .env.example)
.env
.env.local
.env.development
.env.production
.env.*.local
!.env.example
client/.env
client/.env.local
client/.env.development
client/.env.production
client/.env.*.local
