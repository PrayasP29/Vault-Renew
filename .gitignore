server/.env
server/.env.local
server/.env.development
server/.env.production
server/.env.*.local
!server/.env.example

# Firebase / cloud credentials
server/credentials/
*service-account*.json
*firebase-adminsdk*.json
*serviceAccountKey*.json

# Uploaded user files
server/uploads/*
!server/uploads/.gitkeep
uploads/*

